{:source-paths ["src" "test"]
 :dependencies []
 :dev-http {8080 "public"}
 :builds
 {:app  {:target :browser
         :output-dir "public/js"
         :asset-path "/js"
         :modules {:main {:init-fn cube.core/init}}
         :devtools {:watch-dir "public"}}
  :test {:target :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"}}}
