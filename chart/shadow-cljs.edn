{:source-paths ["src"]

 :dependencies
 [[reagent "1.2.0"]]

 ;; Unique HTTP + nREPL ports so this project doesn't fight with sibling
 ;; shadow-cljs projects (ball, cube, landing) running on 8080/8081/8090.
 :dev-http   {8088 "public"}
 :nrepl      {:port 9088}
 :http       {:port 9633}

 :builds
 ;; Build name is deliberately :chart (not :app) so sibling projects'
 ;; :app builds can't collide with ours if a shared server is reached.
 {:chart
  {:target     :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules    {:main {:init-fn chart.core/init}}
   :devtools   {:watch-dir "public"}}}}
